{
  "_schema": {
    "doc": "Named chord units, keyed by scale degree (transposable, key-independent). Named after the most famous exemplar song. cells = 2 chords, sets = 4-chord unordered palettes, loops = 4-chord ordered progressions. Quality is implied by degree in a MAJOR key: 1,4,5 = major; 2,3,6 = minor; 7 = dim. (Borrowed/chromatic degrees to be added later as e.g. 'b7','b3'.)",
    "fields": {
      "key": "slug id",
      "name": "exemplar song",
      "artist": "artist (optional)",
      "n": "number of chords",
      "ordered": "true = a specific loop; false = an unordered set/cell",
      "degrees": "sorted scale degrees (for sets/cells) — the canonical identity",
      "order": "the actual chord order (for loops only)",
      "set": "for a loop: the key of its parent set",
      "entry": "for a loop: the starting chord (its 'stance')",
      "roman": "human-readable roman numerals",
      "chords_C": "letter names in C major (reference only)",
      "has_I": "tonic present?",
      "n_minor": "count of minor chords (2,3,6)",
      "family": "structural family — pillars = I,IV,V; shadows = vi,ii,iii (relative minors of I,IV,V)"
    }
  },
