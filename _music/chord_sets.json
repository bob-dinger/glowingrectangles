{
 "_schema": {
  "doc": "Named chord units, keyed by scale degree (transposable, key-independent). Named after the most famous exemplar song. cells = 2 chords, sets = 4-chord unordered palettes, loops = 4-chord ordered progressions. Quality is implied by degree in a MAJOR key: 1,4,5 = major; 2,3,6 = minor; 7 = dim. (Borrowed/chromatic degrees to be added later as e.g. 'b7','b3'.) Bennett-sourced entries (source='bennett') add named chromatic progressions; they carry mode+roman+chords instead of integer degrees. Minor progressions anchor on Am (relative minor) for white-note consistency with C major.",
  "fields": {
   "key": "slug id",
   "name": "exemplar song",
   "artist": "artist (optional)",
   "n": "number of chords",
   "ordered": "true = a specific loop; false = an unordered set/cell",
   "degrees": "sorted scale degrees (for sets/cells) — the canonical identity",
   "order": "the actual chord order (for loops only)",
   "set": "for a loop: the key of its parent set",
   "entry": "for a loop: the starting chord (its 'stance')",
   "roman": "human-readable roman numerals",
   "chords_C": "letter names in C major (reference only)",
   "has_I": "tonic present?",
   "n_minor": "count of minor chords (2,3,6)",
   "family": "structural family — pillars = I,IV,V; shadows = vi,ii,iii (relative minors of I,IV,V)",
   "mode": "for chromatic/Bennett entries: 'major' (chords spelled in C) or 'minor' (spelled in A minor — the relative minor, same white-note frame)",
   "chords": "letter names in the reference key (C for major-mode, Am for minor-mode). For chromatic entries this + roman are the canonical identity (integer degrees can't hold altered chords)",
   "examples": "well-known songs that use the progression",
   "source": "'bennett' = imported from David Bennett's named-progression videos",
   "songs_exact_palette": "songs with at least one run of consecutive diatonic chords whose distinct degrees are exactly this set (windows of 8/12/16 over the Hookpad corpus, borrowed and applied chords break the run). Comparable across all 35 sets. Distinct from 'corpus_sections', which older entries carry from an earlier pass with a different definition."
  }
 },
